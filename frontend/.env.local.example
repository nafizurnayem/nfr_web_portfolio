# Frontend environment configuration. Copy to `.env.local` for local dev,
# and set the same keys in your hosting provider's dashboard for production.

# Base URL of the FastAPI backend, including the /api prefix.
# Local:      http://localhost:8000/api
# Production: https://api.your-domain.com/api   (must be HTTPS)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Public origin of this site. Used for canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml. No trailing slash.
# Local:      http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
