# Backend environment configuration. Copy to .env and fill in real values.

# --- Database ---
# Default uses SQLite for local development. For Postgres, use:
# postgresql+psycopg2://portfolio:portfolio@localhost:5432/portfolio
DATABASE_URL=sqlite:///./portfolio.db

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-strong-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed origins (frontend URLs).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me-after-first-login

# --- Contact / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_RECEIVER_EMAIL=admin@example.com

# --- Misc ---
APP_ENV=development
